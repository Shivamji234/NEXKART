# ==============================================================================
# NEXKART — Production & Staging Environment Variables Template
# Copy this file to .env or configure these variables directly in your hosting dashboard
# (e.g., Render / Railway for Backend, and Vercel / Netlify for Frontend)
# ==============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# MongoDB Atlas Production Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/nexkart?retryWrites=true&w=majority
MONGODB_URI=

# Database Seeding Safety
# Set to 'false' in production to protect existing catalog and customer records
AUTO_SEED=false

# JSON Web Token Secret
# Generate a strong 64-character secret (e.g. using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend Client Origin URL (Configured for Strict CORS)
# Example: https://nexkart.vercel.app or https://www.nexkart.com
CLIENT_URL=
FRONTEND_URL=

# Backend API Base URL
# Example: https://api.nexkart.com or https://nexkart-api.onrender.com
SERVER_URL=

# Razorpay Payment Gateway Credentials
# Test Mode: https://dashboard.razorpay.com/app/keys (starts with rzp_test_...)
# Live Mode: Activate KYC in Razorpay dashboard, generate Live keys (starts with rzp_live_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email / SMTP Configuration for Real OTP Delivery & Order Confirmations
# For Gmail: Use 16-character App Password (https://myaccount.google.com/apppasswords)
# Or use SendGrid / Brevo / Amazon SES / Resend SMTP credentials
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="NEXKART Concierge" <concierge@nexkart.com>

# Cloudinary Storage for Product Imagery (Persistent Cloud Storage)
# Obtain from https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
